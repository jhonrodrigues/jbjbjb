{
  "name": "JB Agent | Motor Comercial | Tick 1 min (desativado)",
  "nodes": [
    {
      "id": "7aa66510-6a09-4b12-b471-6ea00b1447c1",
      "name": "A cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        260
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "55a24c4a-a7c0-43e6-9b46-32e0071cd25b",
      "name": "Executar motor comercial",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        260
      ],
      "parameters": {
        "method": "POST",
        "url": "https://SEU_DOMINIO_DO_PAINEL/api/internal/sales/tick",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.JB_INTERNAL_API_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    }
  ],
  "connections": {
    "A cada minuto": {
      "main": [
        [
          {
            "node": "Executar motor comercial",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
