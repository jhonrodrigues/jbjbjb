# Banco PostgreSQL (nunca versione o .env real)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jbjbjb
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# PostgreSQL local do Docker Compose (senha literal, sem URL-encoding)
POSTGRES_DB=jb_agent
POSTGRES_USER=jb_agent
POSTGRES_PASSWORD=defina_uma_senha_aleatoria
PORT=3000

# Auth.js
AUTH_SECRET=gere_uma_string_aleatoria_com_openssl_rand_base64_32
APP_URL=http://localhost:3000

# API interna usada pelos workers n8n
INTERNAL_API_SECRET=gere_outra_string_aleatoria_longa

# n8n (opcional)
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# IA (opcional; chave fica somente no servidor)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Preview privado de landing pages
LP_PREVIEW_SECRET=
LP_PREVIEW_ORIGIN=
UPLOAD_DIR=/app/uploads

# Operação
APP_TIMEZONE=America/Sao_Paulo
JOB_LOCK_TIMEOUT_SECONDS=900
LOG_LEVEL=info
